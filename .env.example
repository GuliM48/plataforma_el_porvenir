# Copiar este archivo a .env y ajustar valores antes de desplegar.
# NUNCA subir el archivo .env real (con contraseñas reales) al repositorio.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEFAULT_MODEL=LightGBM

# --- Dashboard (Streamlit) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambiar_esta_password

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
